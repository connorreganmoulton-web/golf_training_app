# Build caches. next-env.d.ts IS committed on purpose: it's what lets
# `tsc --noEmit` run in CI without a Next build first.
*.tsbuildinfo

# Local agent/editor state, not project code. Ignore the contents rather than
# the directory itself, so the negation below can re-include one subtree --
# git will not descend into a directory it has already excluded.
.claude/*
!.claude/skills/
