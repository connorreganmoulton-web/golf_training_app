# ---- Data ----
# SQLite by default: zero setup, one file, easy to back up.
# To host for multiple users, switch prisma/schema.prisma provider to
# "postgresql" and point this at your Postgres instance.
# Relative SQLite paths resolve from prisma/, not the project root, so
# this "../" is what puts the file in ./data/ next to the compose file.
DATABASE_URL="file:../data/golf_training.db"

# ---- Auth ----
# SINGLE_USER=true skips login entirely. This is the default for people
# running it on their own machine. Set to false when hosting for others.
SINGLE_USER=true

# Only needed when SINGLE_USER=false
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional: email magic links (leave blank to disable)
EMAIL_SERVER=""
EMAIL_FROM=""
